{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airadar.local/contracts/ai-radar-daily.schema.json",
  "title": "AI Radar Daily Signals",
  "description": "Contrato para guardar una busqueda diaria de senales de IA Radar.",
  "type": "object",
  "required": [
    "contractVersion",
    "radarDate",
    "generatedAt",
    "topic",
    "locale",
    "signals"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "radarDate": {
      "type": "string",
      "format": "date"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signal"
      }
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source",
        "evidence",
        "impact",
        "action",
        "status",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "required": [
            "name",
            "url",
            "publishedAt",
            "retrievedAt"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "publishedAt": {
              "type": "string",
              "format": "date"
            },
            "retrievedAt": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "impact": {
          "type": "object",
          "required": [
            "level",
            "summary"
          ],
          "additionalProperties": false,
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "medium-high",
                "high"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "debated",
            "evolving",
            "confirmed",
            "actionable",
            "archived"
          ]
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
